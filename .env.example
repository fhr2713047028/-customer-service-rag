# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，绝不进 Git）
# 本阶段只有数据库配置；LLM / Embedding / LangSmith 等 Key 在对应阶段追加

# PostgreSQL 连接串（与 docker-compose.yml 中 postgres 服务保持一致）
DATABASE_URL=postgresql+asyncpg://rag:rag_password@localhost:5432/rag_db

# 连接池（架构文档 7.1 起点值，阶段 9 压测后调优）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# 调试 SQL 时置 true（控制台打印每条 SQL，生产不要开）
DB_ECHO=false

# JWT（测试身份骨架）：必须改为随机强密钥（可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=1440

# Embedding（阶段五）：provider=mock（离线确定性向量，默认）或 openai（真实 BGE-M3）
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=      # 使用真实模型时填写；只走环境变量
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024      # 设计值=BGE-M3 维度；真实接口运行时校验实际返回
EMBEDDING_TIMEOUT_SECONDS=10

# LLM（阶段七）：provider=mock（离线确定性生成，默认）或 openai（DeepSeek）
# 模型名/base_url 以接入时服务商官方文档为准
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=           # 使用真实模型时填写；只走环境变量
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
# 拒答阈值：向量 top-1 相似度低于此值判"无依据"（2026-10-31 mock 语料校准，见 config.py）
KB_REFUSAL_MIN_SCORE=0.10

# LangSmith 链路追踪（阶段十）：默认关闭；有 Key 才启用
# LANGSMITH_TRACING=false 可强制关闭（测试环境默认关闭）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cs-rag
LANGSMITH_TRACING=true
